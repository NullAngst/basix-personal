 breeze-gtk kde-gtk-config plasma-integration qqc2-breeze-style plasma-workspace
 plasma-desktop systemsettings kscreen powerdevil polkit-kde-agent-1 plasma-pa
 kde-cli-tools kmenuedit milou kinfocenter xdg-desktop-portal-kde kwallet-pam
 ksystemstats kdeplasma-addons ocean-sound-theme spectacle kwrited
 breeze-icons kirigami-addons qt6-imageformats kimageformats qt6-wayland
 elogind polkit dbus seatd greetd pipewire wireplumber xdg-desktop-portal
 xwayland mesa noto-fonts hicolor-icon-theme shared-mime-info iso-codes"
