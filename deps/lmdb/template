pkg_name=lmdb
version=0.9.36
revision=1
build_style=custom
short_desc="Lightning memory-mapped key-value database (used by baloo)"
home_page="https://www.symas.com/lmdb"
license="OLDAP-2.8"
dist_files="https://git.openldap.org/openldap/openldap/-/archive/LMDB_${version}/openldap-LMDB_${version}.tar.gz"
checksum="3c7469d72a12b7cc609a5ee7a14fa2fa066cae8d25d45f3e927e159055cda90c"
wrk_src="openldap-LMDB_$version/libraries/liblmdb"

do_build() {
    $make_cmd CC="$CC" CFLAGS="$CFLAGS -fPIC" LDFLAGS="$LDFLAGS"
}

do_install() {
    $make_cmd DESTDIR="$DESTDIR" prefix=/usr install
    sed "s|@VERSION@|$version|" "$FILESDIR/lmdb.pc" > lmdb.pc
    bpkgconfig lmdb.pc
    blicense LICENSE
}
