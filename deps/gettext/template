pkg_name=gettext
version=1.0
revision=1
build_style=gnu-configure
short_desc="GNU gettext tools (fallback, only needed if gettext-tiny cannot build KDE translations)"
home_page="https://www.gnu.org/software/gettext"
license="GPL-3.0-or-later, LGPL-2.1-or-later"
dist_files="https://ftp.gnu.org/gnu/gettext/gettext-${version}.tar.xz"
checksum=""

# Not pulled in by anything in this repo. Its msgfmt and friends collide with
# gettext-tiny's; bpm keeps whichever came first and stores the other copy as
# an alternative (bpm a gettext /usr/bin/msgfmt swaps them).
depends="libunistring libxml2 ncurses"
make_depends="libunistring libxml2 ncurses"

configure_args="
    --disable-static
    --disable-java
    --disable-csharp
    --disable-openmp
    --disable-acl
    --without-emacs
    --without-git
    --without-cvs
    --with-included-gettext=no
    --disable-nls"

pre_configure() {
    # the configure test is broken under busybox ash
    export gt_cv_func_printf_posix=yes
}

post_install() {
    brm /usr/share/doc /usr/share/info /usr/share/gettext/projects
    blicense COPYING
}
