pkg_name=libsass
version=3.6.6
revision=1
build_style=gnu-configure
short_desc="C/C++ Sass compiler library (Breeze GTK themes)"
home_page="https://sass-lang.com/libsass"
license="MIT"
dist_files="https://github.com/sass/libsass/archive/${version}.tar.gz>libsass-${version}.tar.gz"
checksum=""

make_depends="autoconf automake libtool"
configure_args="--disable-static"

pre_configure() {
    # the git archive has no configure script and no VERSION file
    echo "$version" > VERSION
    autoreconf -fi
}

post_install() {
    blicense LICENSE
}
