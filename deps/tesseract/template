pkg_name=tesseract
version=5.5.3
revision=1
build_style=cmake
short_desc="OCR engine (Spectacle's text recognition)"
home_page="https://github.com/tesseract-ocr/tesseract"
license="Apache-2.0"
dist_files="https://github.com/tesseract-ocr/tesseract/archive/${version}.tar.gz>tesseract-${version}.tar.gz"
checksum=""

# Spectacle 6.8 links it unconditionally. No language data is shipped; OCR
# needs e.g. eng.traineddata in /usr/share/tessdata (see the README).
depends="curl leptonica libarchive"
make_depends="cmake samurai pkgconf curl leptonica libarchive"

configure_args="-G Ninja -DBUILD_SHARED_LIBS=ON -DBUILD_TRAINING_TOOLS=OFF -DBUILD_TESTS=OFF
 -DENABLE_LTO=OFF -DGRAPHICS_DISABLED=ON -DOPENMP_BUILD=OFF -DSW_BUILD=OFF
 -DINSTALL_CONFIGS=ON -DDISABLE_TIFF=ON"

post_install() {
    blicense LICENSE
}
