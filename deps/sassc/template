pkg_name=sassc
version=3.6.2
revision=1
build_style=gnu-configure
short_desc="Command line Sass compiler (breeze-gtk, kde-gtk-config)"
home_page="https://github.com/sass/sassc"
license="MIT"
dist_files="https://github.com/sass/sassc/archive/${version}.tar.gz>sassc-${version}.tar.gz"
checksum=""

depends="libsass"
make_depends="autoconf automake libtool libsass"
configure_args="--disable-static"

pre_configure() {
    printf 'echo %s\n' "$version" > version.sh
    autoreconf -fi
}

post_install() {
    blicense LICENSE
}
