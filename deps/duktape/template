pkg_name=duktape
version=2.7.0
revision=1
build_style=custom
short_desc="Embeddable JavaScript engine (polkit's rules engine)"
home_page="https://duktape.org"
license="MIT"
dist_files="https://github.com/svaarala/duktape/releases/download/v${version}/duktape-${version}.tar.xz"
checksum="b0a17da888847bc9c73624ae3ba7f858ec327a9bbce9d287aee6a2489e518448"

do_build() {
    $make_cmd -f Makefile.sharedlibrary INSTALL_PREFIX=/usr
}

do_install() {
    $make_cmd -f Makefile.sharedlibrary install INSTALL_PREFIX=/usr DESTDIR="$DESTDIR"
    blicense LICENSE.txt
}
