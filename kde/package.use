# kde/package.use - written by tools/kde-gen from kde/manifest.
# Copied into /etc/bpm/package.use (inside a marked block) by basix-install
# and by basix-helper when Plasma is installed. bpm.conf's global BPM_USE
# turns x11 off and doc on; these lines turn x11 back on for XWayland
# support and keep the KDE handbooks (doc) off, since they cost build time.
qt6-base x11
kconfigwidgets -doc
kcrash x11
kdbusaddons x11
kded -doc
kglobalaccel x11
kguiaddons x11
kidletime x11
kio x11 -doc
kjobwidgets x11
kpackage -doc
kservice -doc
kstatusnotifieritem x11
kwallet x11 -doc
kwindowsystem x11
kde-cli-tools x11 -doc
kinfocenter -doc
kmenuedit -doc
ksshaskpass -doc
kwin x11 -doc
libplasma -doc
plasma-desktop -doc
plasma-integration x11
plasma-pa -doc
plasma-workspace x11 -doc
powerdevil -doc
spectacle x11 -doc
systemsettings -doc
ark -doc
dolphin -doc
kate -doc
kio-extras -doc
konsole x11 -doc
libxkbcommon x11 xkbregistry
mesa x11
pipewire pulse
