#!/usr/bin/env bash
#
# pkg-bump - move hand-written templates to their newest upstream release
#
# Every package folder with a `watch` file next to its `template` gets checked.
# When upstream has a newer stable release, pkg-bump sets version=, resets
# revision=1, downloads every dist_files entry and writes its BLAKE3 into
# checksum=. A package whose download fails keeps its old version.
#
# Templates generated by kde-gen are skipped, kde-bump owns those.
#
# usage: pkg-bump [--dry-run] [--report FILE] [--repo DIR] [PKG|DIR ...]
#
#   --dry-run      only show what would change, download nothing
#   --report FILE  also write the result table to FILE (markdown)
#   --repo DIR     repository root (default: the git checkout this is in)
#   PKG|DIR        only these packages (names or folders), default all
#
# watch file, one key=value per line, # comments:
#
#   type=git       newest tag of a git repo (GitHub, Codeberg, GitLab, any host)
#     url=https://github.com/owner/repo
#   type=pypi      newest release on PyPI
#     name=project-name
#   type=crates    newest release on crates.io
#     name=crate-name
#   type=url       newest match on a download page or directory listing
#     url=https://ftp.gnu.org/gnu/readline/
#     match=readline-([0-9.]+)\.tar\.gz
#
#   optional (regexes are POSIX extended and must not contain #):
#     tag=REGEX     (git) whole tag, group 1 is the version.
#                   default ^v?([0-9]+(\.[0-9]+)+)$
#     match=REGEX   (url) group 1 is the version
#     filter=REGEX  (pypi, crates) versions to accept,
#                   default ^[0-9]+(\.[0-9]+)+$ (no pre-releases)
#     ignore=REGEX  versions to skip, e.g. ^2\.9[0-9] for a dev series
#     series=PREFIX only versions starting with PREFIX, e.g. 6. to stay on 6.x
#
# Needs bash 4, curl, git, sed, awk, sort -V, and b3sum (or python3 with the
# blake3 module) unless --dry-run. jq for pypi and crates.
#
# exit: 0 all fine, 1 some package failed (the rest is still written), 2 usage
#
set -uo pipefail

prog=${0##*/}
here=$(cd "$(dirname "$0")" && pwd)
lint=$here/lint-template

usage() { sed -n '2,46p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }

dry=0 report='' repo=''
targets=()
while (($#)); do
    case $1 in
        -n|--dry-run) dry=1; shift ;;
        --report) [[ $# -ge 2 ]] || usage; report=$2; shift 2 ;;
        --repo) [[ $# -ge 2 ]] || usage; repo=$2; shift 2 ;;
        -h|--help) usage 0 ;;
        -*) printf '%s: unknown option %s\n' "$prog" "$1" >&2; usage ;;
        *) targets+=("$1"); shift ;;
    esac
done

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 2; }
say() { printf '%s\n' "$*" >&2; }

for t in curl git sed awk sort sh; do
    command -v "$t" >/dev/null 2>&1 || die "$t is required"
done
b3() {
    if command -v b3sum >/dev/null 2>&1; then b3sum "$1" | cut -d' ' -f1
    else python3 -c 'import sys, blake3; print(blake3.blake3(open(sys.argv[1], "rb").read()).hexdigest())' "$1"
    fi
}
if ((!dry)); then
    command -v b3sum >/dev/null 2>&1 || python3 -c 'import blake3' 2>/dev/null ||
        die "b3sum (or python3 with blake3) is required"
fi
[[ -x $lint ]] || die "needs $lint next to it, for evaluating templates"

if [[ -z $repo ]]; then
    repo=$(git -C "$here" rev-parse --show-toplevel 2>/dev/null) || repo=$here/..
fi
repo=$(cd "$repo" 2>/dev/null && pwd) || die "no such repo dir"

work=$(mktemp -d) || die "mktemp failed"
trap 'rm -rf "$work"' EXIT

# the template evaluator lint-template uses, so there is one copy of bpm's
# use helpers to keep in sync
EVAL_SH=$(awk "/^read -r -d '' EVAL_SH <<'EOS'/{on=1; next} /^EOS\$/{on=0} on" "$lint")
[[ -n $EVAL_SH ]] || die "could not read EVAL_SH from $lint"

# tmpl_get <name> <template> <var> -> value with the template's default flags
tmpl_get() {
    sh -c "$EVAL_SH" "$prog" "$1" '' "$2" "$3" 2>/dev/null |
        { IFS= read -r -d '' _ || return 1; IFS= read -r -d '' v || return 1; printf '%s' "$v"; }
}

# ---- upstream lookups -----------------------------------------------------------------

# newest version from stdin, honoring ignore and series
vpick() {
    local ignore=$1 series=$2
    grep -v '^$' |
        { if [[ -n $ignore ]]; then grep -vE -- "$ignore"; else cat; fi; } |
        { if [[ -n $series ]]; then grep -F -- "$series" | awk -v s="$series" 'index($0, s) == 1'; else cat; fi; } |
        sort -V | tail -n 1
}

# 0 when $1 is a newer version than $2
vnewer() {
    [[ $1 != "$2" && $(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1) == "$1" ]]
}

newest() {
    local type=$1 url=$2 name=$3 tag=$4 match=$5 filter=$6 ignore=$7 series=$8
    case $type in
        git)
            [[ -n $url ]] || { say "watch: type=git needs url="; return 1; }
            git ls-remote --tags --refs "$url" 2>/dev/null |
                sed 's|.*refs/tags/||' |
                sed -nE "\\#${tag}#{s#${tag}#\\1#;p}" | vpick "$ignore" "$series" ;;
        pypi)
            [[ -n $name ]] || { say "watch: type=pypi needs name="; return 1; }
            command -v jq >/dev/null 2>&1 || { say "jq is required for pypi"; return 1; }
            curl -fsSL "https://pypi.org/pypi/$name/json" | jq -r '.releases | to_entries[]
                | select((.value | length) > 0 and (.value | all(.yanked | not))) | .key' |
                grep -E -- "$filter" | vpick "$ignore" "$series" ;;
        crates)
            [[ -n $name ]] || { say "watch: type=crates needs name="; return 1; }
            command -v jq >/dev/null 2>&1 || { say "jq is required for crates"; return 1; }
            curl -fsSL -A 'basix-personal pkg-bump (github.com/NullAngst/basix-personal)' \
                "https://crates.io/api/v1/crates/$name/versions" |
                jq -r '.versions[] | select(.yanked | not) | .num' |
                grep -E -- "$filter" | vpick "$ignore" "$series" ;;
        url)
            [[ -n $url && -n $match ]] || { say "watch: type=url needs url= and match="; return 1; }
            curl -fsSL "$url" | grep -oE -- "$match" |
                sed -nE "s#^${match}\$#\\1#p" | vpick "$ignore" "$series" ;;
        *)
            say "watch: unknown type '$type' (git, pypi, crates, url)"; return 1 ;;
    esac
}

# ---- one package -------------------------------------------------------------------------

rows=() failed=0 bumped=()

row() { rows+=("| $1 | $2 | $3 | $4 |"); }

bump_one() {
    local dir=$1 name t w
    name=${dir##*/}
    t=$dir/template
    w=$dir/watch
    [[ -f $t ]] || { row "$name" - - "no template next to watch"; failed=1; return; }
    if head -n 1 "$t" | grep -q '^# Generated by .*kde-gen'; then
        row "$name" - - "skipped, kde-bump owns generated templates"; return
    fi

    local type='' url='' wname='' tag='^v?([0-9]+(\.[0-9]+)+)$' match=''
    local filter='^[0-9]+(\.[0-9]+)+$' ignore='' series='' k v
    while IFS='=' read -r k v; do
        k=${k//[[:space:]]/}
        [[ -z $k || $k == \#* ]] && continue
        case $k in
            type) type=$v ;; url) url=$v ;; name) wname=$v ;; tag) tag=$v ;;
            match) match=$v ;; filter) filter=$v ;; ignore) ignore=$v ;; series) series=$v ;;
            *) say "$name: unknown watch key '$k'" ;;
        esac
    done < "$w"

    local cur new
    cur=$(tmpl_get "$name" "$t" version)
    [[ -n $cur ]] || { row "$name" - - "template does not load, run lint-template"; failed=1; return; }
    new=$(newest "$type" "$url" "$wname" "$tag" "$match" "$filter" "$ignore" "$series")
    if [[ -z $new ]]; then
        row "$name" "$cur" - "FAILED, no version found upstream, check watch"; failed=1; return
    fi
    if ! vnewer "$new" "$cur"; then
        row "$name" "$cur" "$new" "up to date"; return
    fi
    if ((dry)); then
        row "$name" "$cur" "$new" "would bump"; return
    fi

    if [[ $(grep -c '^version=' "$t") != 1 ]]; then
        row "$name" "$cur" "$new" "FAILED, needs exactly one version= line"; failed=1; return
    fi
    if [[ $(grep -cE '^checksum="[^"]*"[[:space:]]*$' "$t") != 1 ]]; then
        row "$name" "$cur" "$new" "FAILED, checksum is not one line, bump by hand"; failed=1; return
    fi

    # new template in a scratch copy, only moved into place when everything worked
    local nt=$work/$name.template
    sed -e "s/^version=.*/version=$new/" -e 's/^revision=.*/revision=1/' "$t" > "$nt"

    local dist e src saved sums='' f checked=0 nfiles=0
    dist=$(tmpl_get "$name" "$nt" dist_files)
    for e in $dist; do
        case $e in
            git+*) sums="$sums SKIP"; say "$name: git source $e, check its #ref follows the version"; continue ;;
        esac
        src=${e%%>*}
        saved=${e##*>}; saved=${saved%%\?*}; saved=${saved##*/}
        f=$work/$name.$saved
        if ! curl -fsSL --retry 3 --retry-delay 5 -o "$f" "$src"; then
            row "$name" "$cur" "$new" "FAILED, download failed: $src"; failed=1; return
        fi
        # PyPI publishes a sha256 for every file, check against it when it's there
        if [[ $type == pypi ]] && command -v sha256sum >/dev/null 2>&1; then
            local want got
            want=$(curl -fsSL "https://pypi.org/pypi/$wname/$new/json" 2>/dev/null |
                   jq -r --arg f "$saved" '.urls[] | select(.filename == $f) | .digests.sha256' 2>/dev/null)
            if [[ -n $want ]]; then
                got=$(sha256sum "$f" | cut -d' ' -f1)
                if [[ $got != "$want" ]]; then
                    row "$name" "$cur" "$new" "FAILED, $saved does not match PyPI's sha256"; failed=1; return
                fi
                checked=$((checked + 1))
            fi
        fi
        sums="$sums $(b3 "$f")"
        nfiles=$((nfiles + 1))
        rm -f "$f"
    done
    sums=${sums# }
    sed -i "s|^checksum=\"[^\"]*\"[[:space:]]*\$|checksum=\"$sums\"|" "$nt"
    cat "$nt" > "$t"
    bumped+=("$dir")
    if ((nfiles > 0 && checked == nfiles)); then
        row "$name" "$cur" "$new" "bumped, downloads match PyPI's sha256"
    else
        row "$name" "$cur" "$new" "bumped, unchecked (trust on first download)"
    fi
}

# ---- run -------------------------------------------------------------------------------------

dirs=()
while IFS= read -r w; do dirs+=("${w%/watch}"); done < <(
    find "$repo" -mindepth 2 -maxdepth 4 -path '*/.git' -prune -o -type f -name watch -print | sort)

if ((${#targets[@]})); then
    sel=()
    for t in "${targets[@]}"; do
        hit=''
        for d in "${dirs[@]}"; do
            if [[ ${d##*/} == "$t" || $d == "$(cd "$t" 2>/dev/null && pwd)" ]]; then sel+=("$d"); hit=1; fi
        done
        [[ -n $hit ]] || { say "$prog: $t has no watch file"; failed=1; }
    done
    dirs=("${sel[@]}")
fi

for d in "${dirs[@]}"; do bump_one "$d"; done

{
    printf '| Package | Was | Upstream | Result |\n|---|---|---|---|\n'
    ((${#rows[@]})) && printf '%s\n' "${rows[@]}"
} > "$work/table"

if ((${#bumped[@]})); then
    printf '\nlint-template on the bumped packages:\n\n```\n' >> "$work/table"
    "$lint" --repo "$repo" "${bumped[@]}" >> "$work/table" 2>&1 || failed=1
    printf '```\n' >> "$work/table"
fi

cat "$work/table"
[[ -n $report ]] && cp "$work/table" "$report"
((failed == 0))
