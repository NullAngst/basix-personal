#!/usr/bin/env bash
#
# check-bpm - has bpm changed since the Packaging files were last checked?
#
# Compares upstream bpm against Packaging/bpm-baseline (what GUIDE.md,
# template.skel and lint-template were written for), and checks the
# Packaging files against what bpm actually contains right now:
#
#   - which bpm version core ships, and which commits came since the baseline
#   - changed, added and removed files, shell functions and bpm.conf defaults
#   - template variables, phase hooks and build styles lint-template knows
#     versus the ones bpm has
#   - lint-template's copy of the use flag helpers versus bpm's
#   - helpers, styles and variables GUIDE.md never mentions
#   - the base package list and BPM_USE default quoted in GUIDE.md and
#     template.skel
#   - commits on bpm's master that core doesn't ship yet
#
# usage: check-bpm [--bpm DIR] [--core DIR] [--ref REF] [--write-baseline]
#
# exit: 0 nothing changed, 1 something changed (read the report), 2 error
#
set -uo pipefail

prog=${0##*/}
here=$(cd "$(dirname "$0")" && pwd)
baseline_file=$here/bpm-baseline
lint=$here/lint-template
guide=$here/GUIDE.md
skel=$here/template.skel

BPM_URL=https://github.com/kkrruumm/bpm
CORE_URL=https://github.com/kkrruumm/basix-packages

usage() {
    printf 'usage: %s [--bpm DIR] [--core DIR] [--ref REF] [--write-baseline]\n\n' "$prog"
    printf '  --bpm DIR         a bpm git clone to use (default: clone %s)\n' "$BPM_URL"
    printf '  --core DIR        a basix-packages checkout (default: shallow clone)\n'
    printf '  --ref REF         bpm tag or commit to check (default: the version\n'
    printf '                    core ships in sys/bpm/template)\n'
    printf '  --write-baseline  record REF as the new baseline, after Packaging/\n'
    printf '                    has been updated for it\n'
    exit "${1:-2}"
}

bpm_dir='' core_dir='' ref='' write=0 ref_given=0
while (($#)); do
    case $1 in
        --bpm) [[ $# -ge 2 ]] || usage; bpm_dir=$2; shift 2 ;;
        --core) [[ $# -ge 2 ]] || usage; core_dir=$2; shift 2 ;;
        --ref) [[ $# -ge 2 ]] || usage; ref=$2; ref_given=1; shift 2 ;;
        --write-baseline) write=1; shift ;;
        -h|--help) usage 0 ;;
        *) printf '%s: unknown argument %s\n' "$prog" "$1" >&2; usage ;;
    esac
done

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 2; }
for tool in git awk sed grep sort comm sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is required"
done

tmp=$(mktemp -d) || die "mktemp failed"
trap 'rm -rf "$tmp"' EXIT

# ---- sources ------------------------------------------------------------------

if [[ -z $bpm_dir ]]; then
    bpm_dir=$tmp/bpm
    git clone -q "$BPM_URL" "$bpm_dir" || die "could not clone $BPM_URL"
else
    [[ -d $bpm_dir/.git ]] || die "$bpm_dir is not a git clone"
    git -C "$bpm_dir" fetch -q --tags origin 2>/dev/null ||
        printf '%s: fetch failed, using what %s already has\n' "$prog" "$bpm_dir" >&2
fi

if [[ -z $ref ]]; then
    if [[ -z $core_dir ]]; then
        core_dir=$tmp/core
        git clone -q --depth 1 "$CORE_URL" "$core_dir" || die "could not clone $CORE_URL"
    fi
    ref=$(sed -n 's/^version=//p' "$core_dir/sys/bpm/template" 2>/dev/null | head -n 1)
    [[ -n $ref ]] || die "no version= in $core_dir/sys/bpm/template"
fi
commit=$(git -C "$bpm_dir" rev-parse -q --verify "$ref^{commit}") ||
    die "bpm has no tag or commit '$ref' (core may ship a version that was never tagged)"
master=$(git -C "$bpm_dir" rev-parse -q --verify "origin/HEAD^{commit}" 2>/dev/null ||
         git -C "$bpm_dir" rev-parse -q --verify "HEAD^{commit}")

show() { git -C "$bpm_dir" show "$1:$2" 2>/dev/null; }
files_at() { git -C "$bpm_dir" ls-tree -r --name-only "$1" | grep -E '^(bpm|lib/.*\.sh|etc/.*)$' | sort; }

# every top-level shell function in a file, as "name<TAB>normalized body"
# (comments and blank lines dropped, indentation squashed)
funcs() {
    awk '
        function norm(l) { sub(/^[ \t]+/, "", l); sub(/[ \t]+$/, "", l); gsub(/[ \t]+/, " ", l); return l }
        /^[A-Za-z_][A-Za-z0-9_]*\(\)[ \t]*\{.*\}[ \t]*$/ {
            n = $0; sub(/\(\).*/, "", n); print n "\t" norm($0); next
        }
        /^[A-Za-z_][A-Za-z0-9_]*\(\)[ \t]*\{[ \t]*$/ { n = $0; sub(/\(\).*/, "", n); body = ""; infn = 1; next }
        infn && /^\}/ { print n "\t" body; infn = 0; next }
        infn { l = norm($0); if (l != "" && l !~ /^#/) body = body l ";" }
    '
}

# ": "${VAR:=value}"" defaults in bpm.conf, as "VAR<TAB>value"
conf_defaults() {
    sed -n 's/^:[[:space:]]*"\${\([A-Z_][A-Z0-9_]*\):=\(.*\)}"[[:space:]]*$/\1\t\2/p'
}

# the whole state of a ref, in baseline format
snapshot() {
    local r=$1 f
    printf 'ref %s\n' "$r"
    printf 'commit %s\n' "$(git -C "$bpm_dir" rev-parse "$r^{commit}")"
    printf 'date %s\n' "$(git -C "$bpm_dir" log -1 --format=%cs "$r")"
    while IFS= read -r f; do
        printf 'file %s %s\n' "$f" "$(show "$r" "$f" | sha256sum | cut -d' ' -f1)"
    done < <(files_at "$r")
    while IFS= read -r f; do
        case $f in bpm|lib/*.sh) ;; *) continue ;; esac
        show "$r" "$f" | funcs | while IFS=$'\t' read -r n b; do
            printf 'func %s:%s %s\n' "$f" "$n" "$(printf '%s' "$b" | sha256sum | cut -d' ' -f1)"
        done
    done < <(files_at "$r")
    show "$r" etc/bpm.conf | conf_defaults | while IFS=$'\t' read -r k v; do
        printf 'conf %s %s\n' "$k" "$v"
    done
}

if ((write)); then
    {
        printf '# bpm-baseline - the bpm version the Packaging files were last checked\n'
        printf '# against. Written by check-bpm --write-baseline, do not edit by hand.\n'
        snapshot "$ref"
    } > "$baseline_file" || die "could not write $baseline_file"
    printf '%s: baseline is now bpm %s (%s)\n' "$prog" "$ref" "${commit:0:12}"
    exit 0
fi

# ---- report -------------------------------------------------------------------------

drift=0
section() { printf '\n== %s\n' "$*"; }
item() { printf '   %s\n' "$*"; drift=1; }
info() { printf '   %s\n' "$*"; }

[[ -f $baseline_file ]] || die "no $baseline_file, run with --write-baseline once"
snapshot "$ref" > "$tmp/now"
grep -v '^#' "$baseline_file" > "$tmp/base"

base_ref=$(sed -n 's/^ref //p' "$tmp/base")
base_commit=$(sed -n 's/^commit //p' "$tmp/base")

if ((ref_given)); then
    printf 'checking bpm %s (%s)\n' "$ref" "${commit:0:12}"
else
    printf 'core ships bpm %s (%s)\n' "$ref" "${commit:0:12}"
fi
printf 'baseline is bpm %s (%s)\n' "$base_ref" "${base_commit:0:12}"

section "commits since the baseline"
if [[ $base_commit == "$commit" ]]; then
    info "none"
elif git -C "$bpm_dir" merge-base --is-ancestor "$base_commit" "$commit" 2>/dev/null; then
    while IFS= read -r l; do item "$l"; done < <(git -C "$bpm_dir" log --oneline "$base_commit..$commit")
else
    item "baseline commit $base_commit is not an ancestor of $ref, history was rewritten or the ref went backwards"
fi

# kind: file, func, conf
diff_kind() {
    local kind=$1 label=$2
    sed -n "s/^$kind //p" "$tmp/base" > "$tmp/b.$kind"
    sed -n "s/^$kind //p" "$tmp/now" > "$tmp/n.$kind"
    # key is the first word, value the rest
    awk '{k=$1; $1=""; print k "\t" substr($0,2)}' "$tmp/b.$kind" | sort > "$tmp/bk"
    awk '{k=$1; $1=""; print k "\t" substr($0,2)}' "$tmp/n.$kind" | sort > "$tmp/nk"
    section "$label"
    local any=0 k v old
    while IFS=$'\t' read -r k v; do
        if ! awk -F'\t' -v k="$k" '$1 == k {f = 1} END {exit !f}' "$tmp/bk"; then
            item "added    $k${v:+  ($v)}"; any=1
            continue
        fi
        old=$(awk -F'\t' -v k="$k" '$1 == k {print $2}' "$tmp/bk")
        if [[ $old != "$v" ]]; then
            if [[ $kind == conf ]]; then item "changed  $k: $old  ->  $v"; else item "changed  $k"; fi
            any=1
        fi
    done < "$tmp/nk"
    while IFS=$'\t' read -r k v; do
        awk -F'\t' -v k="$k" '$1 == k {f = 1} END {exit !f}' "$tmp/nk" || { item "removed  $k"; any=1; }
    done < "$tmp/bk"
    ((any)) || info "no changes"
}
diff_kind file "files"
diff_kind func "shell functions (bpm, lib/*.sh)"
diff_kind conf "bpm.conf defaults"

# ---- the Packaging files versus bpm at REF ---------------------------------------

common=$(show "$ref" lib/common.sh)
build=$(show "$ref" lib/build.sh)
conf=$(show "$ref" etc/bpm.conf)
all_src=$(show "$ref" bpm; printf '%s\n%s\n' "$common" "$build")

known=$("$lint" --print-known) || die "lint-template --print-known failed"
k_vars=$(sed -n 's/^vars //p' <<<"$known" | tr ' ' '\n' | sort -u)
k_hooks=$(sed -n 's/^hooks //p' <<<"$known" | tr ' ' '\n' | sort -u)
k_styles=$(sed -n 's/^styles //p' <<<"$known" | tr ' ' '\n' | sort -u)

# bpm's template variables
b_vars=$(awk "/^TMPL_VARS='/{on=1; sub(/^TMPL_VARS='/, \"\")} on{line=\$0; if (sub(/'.*/, \"\", line)) {print line; exit} print line}" <<<"$common" |
         tr -s '[:space:]' '\n' | grep -v '^$' | sort -u)

# hooks: pre_/do_/post_ for every phase build_run calls, plus every other
# do_/pre_/post_ name bpm tests for with have
phases=$(grep -v '^[[:space:]]*#' <<<"$build" | grep -oE '(^|[;[:space:]])phase [a-z]+' | awk '{print $NF}' | sort -u)
b_hooks=$( { for p in $phases; do printf 'pre_%s\ndo_%s\npost_%s\n' "$p" "$p" "$p"; done
             grep -oE 'have (do|pre|post)_[a-z]+' <<<"$all_src" | awk '{print $2}'; } | sort -u)

b_styles=$(git -C "$bpm_dir" ls-tree --name-only "$ref" lib/style/ | sed 's|.*/||; s|\.sh$||' | sort -u)
compare_sets() {
    local label=$1 bpm_set=$2 our_set=$3 where=$4 x
    section "$label"
    local any=0
    for x in $(comm -23 <(printf '%s\n' "$bpm_set") <(printf '%s\n' "$our_set")); do
        item "bpm has $x, $where does not"; any=1
    done
    for x in $(comm -13 <(printf '%s\n' "$bpm_set") <(printf '%s\n' "$our_set")); do
        item "$where has $x, bpm does not any more"; any=1
    done
    ((any)) || info "match"
}
compare_sets "template variables (TMPL_VARS)" "$b_vars" "$k_vars" "lint-template"
compare_sets "phase hooks bpm calls" "$b_hooks" "$k_hooks" "lint-template"
compare_sets "build styles (lib/style)" "$b_styles" "$k_styles" "lint-template"

# use helpers: lint-template evaluates templates with a copy of them
section "use flag helpers copied into lint-template"
# use_load, use_effective and usedep_check are bpm internals templates never
# call, every other use* function is a helper templates can use
helper_names=$(grep -oE '^use[a-z_]*\(\)' <<<"$common" | sed 's/()//' |
               grep -vxE 'use_load|use_effective|usedep_check' | sort -u)
lint_eval=$(awk "/^read -r -d '' EVAL_SH <<'EOS'/{on=1; next} /^EOS\$/{on=0} on" "$lint")
any=0
for h in $helper_names; do
    a=$(funcs <<<"$common" | awk -F'\t' -v n="$h" '$1 == n {print $2}')
    b=$(funcs <<<"$lint_eval" | awk -F'\t' -v n="$h" '$1 == n {print $2}')
    if [[ -z $b ]]; then item "$h is in bpm but not in lint-template's EVAL_SH"; any=1
    elif [[ $a != "$b" ]]; then item "$h differs between bpm and lint-template's EVAL_SH"; any=1
    fi
done
for h in $(funcs <<<"$lint_eval" | cut -f1 | grep '^use' | sort -u); do
    grep -qx "$h" <<<"$helper_names" || { item "lint-template defines $h, bpm does not"; any=1; }
done
((any)) || info "match"

# names GUIDE.md should mention
section "bpm names GUIDE.md never mentions"
install_helpers=$(grep -oE '^b[a-z]+\(\)' <<<"$build" | sed 's/()//' | sort -u)
any=0
for x in $b_vars $b_styles $install_helpers $helper_names; do
    grep -q -- "\`$x" "$guide" || { item "$x"; any=1; }
done
((any)) || info "none, every variable, style and helper is in there"

# defaults quoted in GUIDE.md and template.skel
section "bpm.conf defaults quoted in GUIDE.md and template.skel"
basepkgs=$(conf_defaults <<<"$conf" | awk -F'\t' '$1 == "BPM_BASEPKGS" {print $2}')
bpmuse=$(conf_defaults <<<"$conf" | awk -F'\t' '$1 == "BPM_USE" {print $2}')
any=0
for f in "$guide" "$skel"; do
    if [[ -n $basepkgs ]] && ! tr -s '[:space:]#' ' ' < "$f" | grep -qF -- "$basepkgs"; then
        item "${f##*/} does not quote the current BPM_BASEPKGS: $basepkgs"; any=1
    fi
    if [[ -n $bpmuse ]] && ! grep -qF -- "$bpmuse" "$f"; then
        item "${f##*/} does not quote the current BPM_USE: $bpmuse"; any=1
    fi
done
((any)) || info "match"

# the repo layout bpm searches
section "repository lookup depth (pkg_find)"
lookup=$(funcs <<<"$common" | awk -F'\t' '$1 == "pkg_find" {print $2}')
# shellcheck disable=SC2016 # the text of bpm's glob, not an expansion
if [[ $lookup == *'"$_r"/*/*/"$1"/template'* && $lookup != *'"$_r"/*/*/*/"$1"'* ]]; then
    info "still <repo>/<pkg>, <repo>/<group>/<pkg>, <repo>/<group>/<sub>/<pkg>"
else
    item "pkg_find changed, recheck the layout rules in GUIDE.md, the README and lint-template"
fi

# ---- upcoming ---------------------------------------------------------------------------

section "on bpm master but not in $ref (core doesn't ship these yet)"
ahead=''
[[ -n $master ]] && ahead=$(git -C "$bpm_dir" log --oneline "$commit..$master")
if [[ -z $ahead ]]; then
    printf '   none\n'
else
    printf '%s\n' "$ahead" | sed 's/^/   /'
fi

printf '\n'
if ((drift)); then
    printf '%s: bpm or the Packaging files changed, see above. Update Packaging/ (UPDATE.md), then: %s --write-baseline\n' "$prog" "$prog"
    exit 1
fi
printf '%s: nothing changed since the baseline\n' "$prog"
exit 0
