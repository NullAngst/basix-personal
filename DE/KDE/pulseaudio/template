pkg_name=pulseaudio
version=17.0
revision=1
build_style=meson
short_desc="PulseAudio client library only (PipeWire is the server)"
home_page="https://www.freedesktop.org/wiki/Software/PulseAudio"
license="LGPL-2.1-or-later"
dist_files="https://www.freedesktop.org/software/pulseaudio/releases/pulseaudio-${version}.tar.xz"
checksum="e56408636f88e3c8b7575795722ebccd7cadb032f7cefda3d055af549b34df4f"

# plasma-pa, pulseaudio-qt, libcanberra and Qt Multimedia link libpulse.
# pipewire-pulse (pipewire's "pulse" flag) serves them; no daemon is built.
depends="dbus glib libsndfile"
make_depends="dbus glib libsndfile m4 meson perl pkgconf gettext-tiny"

configure_args="
    -Ddaemon=false
    -Dclient=true
    -Ddoxygen=false
    -Dman=false
    -Dtests=false
    -Ddatabase=simple
    -Dglib=enabled
    -Ddbus=enabled
    -Dgsettings=disabled
    -Dalsa=disabled
    -Dasyncns=disabled
    -Davahi=disabled
    -Dbluez5=disabled
    -Dconsolekit=disabled
    -Delogind=disabled
    -Dfftw=disabled
    -Dgstreamer=disabled
    -Dgtk=disabled
    -Djack=disabled
    -Dlirc=disabled
    -Dopenssl=disabled
    -Dorc=disabled
    -Doss-output=disabled
    -Dsamplerate=disabled
    -Dsoxr=disabled
    -Dspeex=disabled
    -Dsystemd=disabled
    -Dtcpwrap=disabled
    -Dudev=disabled
    -Dvalgrind=disabled
    -Dwebrtc-aec=disabled
    -Dx11=disabled
    -Dbashcompletiondir=no
    -Dzshcompletiondir=no"

