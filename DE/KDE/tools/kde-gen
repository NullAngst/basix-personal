#!/bin/sh
# kde-gen - write every Qt 6 and KDE template in DE/KDE from DE/KDE/manifest.
#
#   DE/KDE/tools/kde-gen            regenerate the templates, package.use and patches
#   DE/KDE/tools/kde-gen --check    exit 1 if anything committed differs from a fresh run
#
# Templates go to DE/KDE/<pkg>/template. bpm 0.9 only looks two folders deep
# into a repository (<repo>/*/*/<pkg>/template), so there is no category level
# under DE/KDE. Generated templates start with a "Generated by tools/kde-gen"
# line; hand edits to them are lost on the next run, change the manifest.
set -eu

cd "$(dirname "$0")/.."
MANIFEST=manifest
[ -r "$MANIFEST" ] || { echo "kde-gen: no $MANIFEST" >&2; exit 1; }

check=0
case ${1:-} in
    --check) check=1 ;;
    '') ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "kde-gen: unknown option $1" >&2; exit 1 ;;
esac

out=.
if [ "$check" = 1 ]; then
    out=$(mktemp -d)
    trap 'rm -rf "$out"' EXIT
fi

# The awk program prints "cat pkg x11flag" for each package after writing its
# template, so the shell can copy patches and build package.use.
list=$(awk -v out="$out" '
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/\$/, "\\$", s); gsub(/`/, "\\`", s); return s }
function uniqwords(s,   n, a, i, seen, r) {
    n = split(s, a, /[ \t]+/); r = ""
    for (i = 1; i <= n; i++) if (a[i] != "" && !(a[i] in seen)) { seen[a[i]] = 1; r = r (r == "" ? "" : " ") a[i] }
    return r
}
function uniqlic(s,   n, a, i, seen, r, t) {
    n = split(s, a, /,/); r = ""
    for (i = 1; i <= n; i++) { t = trim(a[i]); if (t != "" && !(t in seen)) { seen[t] = 1; r = r (r == "" ? "" : ", ") t } }
    return r
}
function wrap(name, s,   n, a, i, line, r, tok) {
    # name="word word ..." folded at ~76 columns like core templates; a
    # $(...) group is never split, a newline inside it would end the command
    n = split(s, a, / /); r = ""; line = ""
    for (i = 1; i <= n; i++) {
        tok = a[i]
        if (substr(tok, 1, 2) == "$(" && tok !~ /\)"?$/) {
            while (i < n && tok !~ /\)"?$/) { i++; tok = tok " " a[i] }
        }
        if (line != "" && length(line) + length(tok) > 70) { r = r line "\n"; line = " " tok }
        else line = line (line == "" ? "" : " ") tok
    }
    return r line
}
function url_for(st, src,   u) {
    if (st == "frameworks") return "https://download.kde.org/stable/frameworks/${version%.*}/" src "-${version}.tar.xz"
    if (st == "plasma") return "https://download.kde.org/stable/plasma/${version}/" src "-${version}.tar.xz"
    if (st == "gear") return "https://download.kde.org/stable/release-service/${version}/src/" src "-${version}.tar.xz"
    if (st == "qt") return "https://download.qt.io/official_releases/qt/${version%.*}/${version}/submodules/" src "-everywhere-src-${version}.tar.xz"
    return ""
}
function reset() {
    split("", F); pkg = ""
}
function emit(   st, src, ver, url, f, flags, deps, mk, run, args, x11, docs, kde, qt, rev, opt, inv) {
    st = F["set"]; src = (F["src"] != "" ? F["src"] : pkg)
    if (st == "standalone") { ver = F["version"]; url = F["url"] } else { ver = SETV[st]; url = url_for(st, src) }
    if (ver == "") { printf "kde-gen: %s: no version (set %s)\n", pkg, st > "/dev/stderr"; exit 1 }
    if (url == "") { printf "kde-gen: %s: no url\n", pkg > "/dev/stderr"; exit 1 }
    qt = (st == "qt"); kde = !qt
    rev = (F["revision"] != "" ? F["revision"] : 1)
    docs = F["docs"]; if (docs == "") docs = "no"
    x11 = F["x11"]

    flags = ""
    if (x11 != "") flags = "x11"
    if (docs != "no") flags = flags " man -doc"
    if (kde) flags = flags " -nls"
    flags = trim(flags)

    deps = uniqwords(F["depends"] " " F["run"])
    mk = "cmake samurai pkgconf"
    if (kde && pkg != "extra-cmake-modules") mk = mk " extra-cmake-modules"
    mk = uniqwords(mk " " F["depends"] " " F["make"])
    if (docs == "required") mk = mk " kdoctools"
    else if (docs == "optional") mk = mk " $(use_if man kdoctools) $(use_if doc kdoctools)"

    args = "-G Ninja"
    if (kde) args = args " -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON -DBUILD_PYTHON_BINDINGS=OFF -DBUILD_DESIGNERPLUGIN=OFF"
    if (qt) args = args " -DQT_BUILD_TESTS=OFF -DQT_BUILD_EXAMPLES=OFF"
    if (F["args"] != "") args = args " " F["args"]
    if (x11 != "") {
        opt = x11; inv = 0
        if (substr(opt, 1, 1) == "!") { inv = 1; opt = substr(opt, 2) }
        if (inv) args = args " $(use_if x11 -D" opt "=OFF -D" opt "=ON)"
        else args = args " $(use_cmake x11 " opt ")"
    }

    f = out "/" pkg "/template"
    system("mkdir -p \"" out "/" pkg "\"")
    print "# Generated by DE/KDE/tools/kde-gen from DE/KDE/manifest. Edit the manifest and" > f
    print "# rerun kde-gen; hand edits to this file are lost." > f
    print "pkg_name=" pkg > f
    print "version=" ver > f
    print "revision=" rev > f
    print "build_style=cmake" > f
    print "short_desc=\"" esc(F["desc"]) "\"" > f
    print "home_page=\"" F["home"] "\"" > f
    print "license=\"" uniqlic(F["license"]) "\"" > f
    print "dist_files=\"" url "\"" > f
    print "checksum=\"" F["checksum"] "\"" > f
    if (qt) print "wrk_src=\"" src "-everywhere-src-$version\"" > f
    if (F["network"] == "yes") {
        print "" > f
        print "# Rust crates are fetched at build time" > f
        print "allow_network=yes" > f
    }
    print "" > f
    if (flags != "") print "use_flags=\"" flags "\"" > f
    if (deps != "") print wrap("depends", "depends=\"" deps "\"") > f
    print wrap("make_depends", "make_depends=\"" mk "\"") > f
    print "" > f
    print wrap("configure_args", "configure_args=\"" args "\"") > f
    if (kde) {
        print "" > f
        print "pre_configure() {" > f
        print "    # translations are only built with the nls use flag" > f
        print "    if ! use nls; then rm -rf po poqm; fi" > f
        print "}" > f
    }
    print "" > f
    print "post_install() {" > f
    if (docs != "no") {
        print "    use man || brm /usr/share/man" > f
        print "    use doc || brm /usr/share/doc/HTML" > f
    }
    print "    for _l in LICENSES/* LICENSE* COPYING*; do" > f
    print "        if [ -f \"$_l\" ]; then blicense \"$_l\"; fi" > f
    print "    done" > f
    print "}" > f
    close(f)
    print pkg, (x11 != "" ? "x11" : "-"), (docs != "no" ? "-doc" : "-")
}
BEGIN { reset() }
/^[ \t]*#/ || /^[ \t]*$/ { next }
$1 == "set" && pkg == "" { SETV[$2] = $3; next }
$1 == "pkg" { reset(); pkg = $2; next }
$1 == "end" { emit(); reset(); next }
pkg != "" {
    key = $1; val = $0; sub(/^[ \t]*[^ \t]+[ \t]*/, "", val)
    F[key] = trim(val); next
}
{ printf "kde-gen: stray line: %s\n", $0 > "/dev/stderr"; exit 1 }
' "$MANIFEST")

printf '%s\n' "$list" | while read -r pkg _ _; do
    [ -n "$pkg" ] || continue
    # patches: patches/<pkg>/ is the source, the template dir gets a copy
    rm -rf "${out:?}/$pkg/patches"
    if [ -d "patches/$pkg" ]; then
        mkdir -p "$out/$pkg/patches"
        cp patches/"$pkg"/*.patch "$out/$pkg/patches/"
    fi
done

{
    echo "# DE/KDE/package.use - written by DE/KDE/tools/kde-gen from DE/KDE/manifest."
    echo "# Copied into /etc/bpm/package.use (inside a marked block) by basix-install"
    echo "# and by basix-helper when Plasma is installed. bpm.conf's global BPM_USE"
    echo "# turns x11 off and doc on; these lines turn x11 back on for XWayland"
    echo "# support and keep the KDE handbooks (doc) off, since they cost build time."
    printf '%s\n' "$list" | awk '{ l = ($2 == "x11" ? " x11" : "") ($3 == "-doc" ? " -doc" : ""); if (l != "") print $1 l }'
    echo "libxkbcommon x11 xkbregistry"
    # XWayland is built with GLX, which needs mesa's libGL (x11 only)
    echo "mesa x11"
    echo "libepoxy x11"
    echo "pipewire pulse"
} >"$out/package.use.tmp"
mv -f "$out/package.use.tmp" "$out/package.use"

n=$(printf '%s\n' "$list" | grep -c .)
if [ "$check" = 1 ]; then
    rc=0
    printf '%s\n' "$list" | while read -r pkg _ _; do
        [ -n "$pkg" ] || continue
        if ! diff -r "$out/$pkg" "$pkg" >/dev/null 2>&1; then
            echo "kde-gen: $pkg differs from the manifest" >&2
            echo 1 >"$out/.fail"
        fi
    done
    cmp -s "$out/package.use" package.use || { echo "kde-gen: package.use differs" >&2; echo 1 >"$out/.fail"; }
    [ -f "$out/.fail" ] && rc=1
    [ "$rc" = 0 ] && echo "kde-gen: all $n generated templates match the manifest."
    exit "$rc"
fi
echo "kde-gen: wrote $n templates and package.use."
