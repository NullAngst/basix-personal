#!/bin/sh
# args: <pkg_name> <root>/ <version>
# rebuild the MIME database, cheap enough to do after every package
root=${2%/}
[ -x "$root/usr/bin/update-mime-database" ] || exit 0
[ -d "$root/usr/share/mime/packages" ] || exit 0
if [ -n "$root" ]; then
    chroot "$root" /usr/bin/update-mime-database /usr/share/mime
else
    /usr/bin/update-mime-database /usr/share/mime
fi
