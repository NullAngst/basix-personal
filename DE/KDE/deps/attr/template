pkg_name=attr
version=2.5.2
revision=1
build_style=gnu-configure
short_desc="Extended attribute library and tools (kfilemetadata needs libattr)"
home_page="https://savannah.nongnu.org/projects/attr"
license="LGPL-2.1-or-later, GPL-2.0-or-later"
dist_files="https://download.savannah.nongnu.org/releases/attr/attr-${version}.tar.xz"
checksum="d0831671ff83c7195b184b41a6052d1f05ed75b06bacea61dc19038c31d32204"

# same upstream file and checksum as kkrruumm/basix-personal's attr; carried
# here too so this repo does not depend on that one being enabled
use_flags="man -nls"

make_depends="$(use_if nls gettext-tiny)"

configure_args="--disable-rpath --disable-static $(use_enable nls)"

post_install() {
    use man || brm /usr/share/man
    brm /usr/share/doc
    for f in doc/COPYING*; do
        if [ -f "$f" ]; then blicense "$f"; fi
    done
}
