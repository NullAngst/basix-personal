pkg_name=boost-headers
version=1.92.0
revision=1
build_style=custom
short_desc="Boost C++ headers only (kactivitymanagerd, plasma-activities)"
home_page="https://www.boost.org"
license="BSL-1.0"
dist_files="https://github.com/boostorg/boost/releases/download/boost-${version}/boost-${version}-b2-nodocs.tar.xz"
checksum="e5cff3278ddf6365e1d7b3f76c45fa183d7ab31149b35cdffe65c5e00f589a47"
wrk_src="boost-$version"

# Only headers are used by the Plasma set, so nothing is compiled. A full
# Boost belongs in core if Kris ever adds one; then this package goes.
do_build() { :; }

do_install() {
    bmkdir /usr/include
    cp -R boost "$DESTDIR/usr/include/"
    blicense LICENSE_1_0.txt
}
