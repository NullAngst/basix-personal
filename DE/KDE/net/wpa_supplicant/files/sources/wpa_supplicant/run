#!/bin/sh
# wpa_supplicant for s6, written for basix-personal. The interface comes from
# /etc/wpa_supplicant/s6.conf; when it is empty, the first wireless one is used.
exec 2>&1
WPA_INTERFACE=
WPA_CONF=/etc/wpa_supplicant/wpa_supplicant.conf
WPA_ARGS=
# shellcheck source=/dev/null
[ -r /etc/wpa_supplicant/s6.conf ] && . /etc/wpa_supplicant/s6.conf
if [ -z "$WPA_INTERFACE" ]; then
    for n in /sys/class/net/*; do
        if [ -d "$n/wireless" ] || [ -L "$n/phy80211" ]; then WPA_INTERFACE=${n##*/}; break; fi
    done
fi
[ -n "$WPA_INTERFACE" ] || { echo "wpa_supplicant: no wireless interface"; exec sleep 60; }
# shellcheck disable=SC2086
exec wpa_supplicant -i "$WPA_INTERFACE" -c "$WPA_CONF" $WPA_ARGS
