pkg_name=elogind
version=255.24
revision=1
build_style=meson
short_desc="Standalone logind: session, seat and power tracking without systemd"
home_page="https://github.com/elogind/elogind"
license="GPL-2.0-or-later, LGPL-2.1-or-later"
dist_files="https://github.com/elogind/elogind/archive/v${version}.tar.gz>elogind-${version}.tar.gz"
checksum="2b0acd8af5635a0a5142fb46b395a02310aadf6d78b7f0db691cef57fb50b074"
wrk_src="elogind-$version"

# KWin's DRM backend only talks to logind (or ConsoleKit), so Plasma needs this.
# The musl patches are Alpine's, written for this exact version.
use_flags="man services"

depends="dbus libcap libudev-zero linux-pam"
make_depends="dbus gperf libcap libudev-zero linux-pam m4 meson pkgconf
 python python-jinja2 gettext-tiny $(use_if man "docbook-xsl libxslt")"

configure_args="
    --libexecdir=/usr/libexec/elogind
    -Dcgroup-controller=elogind
    -Ddefault-hierarchy=unified
    -Ddefault-kill-user-processes=false
    -Dhalt-path=/usr/bin/halt
    -Dpoweroff-path=/usr/bin/poweroff
    -Dreboot-path=/usr/bin/reboot
    -Dpolkit=enabled
    -Dpamconfdir=/etc/pam.d
    -Dpamlibdir=/usr/lib/security
    -Dudevrulesdir=/usr/lib/udev/rules.d
    -Dsplit-usr=false
    -Dutmp=false
    -Dtests=false
    -Dacl=disabled
    -Daudit=disabled
    -Dselinux=disabled
    -Dsmack=false
    -Dzshcompletiondir=no
    -Dbashcompletiondir=no
    $(use_if man -Dman=enabled -Dman=disabled)"

pre_configure() {
    export XML_CATALOG_FILES=/usr/share/xsl/docbook/catalog.xml
}

post_install() {
    # programs built against systemd's names find elogind under them
    bln libelogind.pc /usr/lib/pkgconfig/libsystemd.pc
    bln libelogind.pc /usr/lib/pkgconfig/libsystemd-logind.pc
    bln elogind /usr/include/systemd

    if use services; then
        bcopy "$FILESDIR/sources/." /usr/share/s6-rc/sources
        find "$DESTDIR/usr/share/s6-rc/sources" -type f -name run -exec chmod 0755 {} +
    fi
    blicense LICENSE.GPL2
    blicense LICENSE.LGPL2.1
}
